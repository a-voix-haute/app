<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr_FR</string>
	<key>CFBundleExecutable</key>
	<string>Lecteur</string>
	<key>CFBundleIdentifier</key>
	<string>fr.dimitri.Lecteur</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lecteur</string>
	<key>CFBundleDisplayName</key>
	<string>Lecteur</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<!-- Application accessoire : pas d'icône dans le Dock, pas d'entrée Cmd+Tab. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Canal d'entrée : menu Services de toute application. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Lire à voix haute</string>
			</dict>
			<key>NSMessage</key>
			<string>lireSelection</string>
			<key>NSPortName</key>
			<string>Lecteur</string>
			<!-- Les deux formes sont déclarées : NSStringPboardType reste la
			     mieux reconnue par les applications anciennes, public.utf8-plain-text
			     par les récentes. -->
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>Any</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>Lit la sélection à voix haute dans un lecteur flottant</string>
		</dict>
	</array>

	<!-- Canal d'entrée : URL scheme lire:// -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.Lecteur.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lire</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
