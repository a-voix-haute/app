<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr_FR</string>
	<key>CFBundleExecutable</key>
	<string>AVoixHaute</string>
	<key>CFBundleIdentifier</key>
	<string>fr.dimitri.AVoixHaute</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>À Voix Haute</string>
	<key>CFBundleDisplayName</key>
	<string>À Voix Haute</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Alimenté par MARKETING_VERSION, que le script de génération dérive
	     du tag Git lors d'une publication. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIconFile</key>
	<string>AVoixHaute</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<!-- Application accessoire : pas d'icône dans le Dock, pas d'entrée Cmd+Tab. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Canal d'entrée : menu Services de toute application. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Lire à voix haute</string>
			</dict>
			<key>NSMessage</key>
			<string>lireSelection</string>
			<!-- Doit correspondre au nom de l'exécutable, sans accent ni espace. -->
			<key>NSPortName</key>
			<string>AVoixHaute</string>
			<!-- Les deux formes sont déclarées : NSStringPboardType reste la
			     mieux reconnue par les applications anciennes, public.utf8-plain-text
			     par les récentes. -->
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>Any</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>Lit la sélection à voix haute dans un lecteur flottant</string>
		</dict>
	</array>

	<!-- Canal d'entrée : URL scheme lire://, décliné dans les six langues de
	     l'application. Les formes sont toutes actives en permanence et non
	     choisies d'après la langue du système : une URL notée dans un script
	     doit fonctionner sur toutes les machines.

	     Doit rester en accord avec `DelegueApplication.schemas`.

	     Une entrée par schéma, et non six schémas dans une même entrée :
	     LaunchServices n'enregistre alors que le premier de la liste et
	     ignore les suivants sans rien signaler. Chaque entrée porte donc son
	     propre CFBundleURLName. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.AVoixHaute.url.lire</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lire</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.AVoixHaute.url.read-aloud</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>read-aloud</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.AVoixHaute.url.leer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>leer</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.AVoixHaute.url.vorlesen</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vorlesen</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.AVoixHaute.url.leggi</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>leggi</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>fr.dimitri.AVoixHaute.url.ler</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ler</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
